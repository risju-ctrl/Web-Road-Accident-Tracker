PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=accident_reporting
# Postgres (Supabase) connection. DATABASE_URL wins when it is set. Copy it from the
# Supabase dashboard -> Connect (session pooler on port 5432, or the direct
# connection). Do not use the transaction pooler (port 6543) with this app.
DATABASE_URL=
DB_PORT=5432
# Required: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=8h
UPLOAD_DIR=uploads
# Comma separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# Only used by `npm run seed`
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
SEED_REPORTER_PASSWORD=
# Duplicate reports: two reports count as the same accident when they are within this many
# metres and this many minutes of each other (defaults shown).
DUPLICATE_RADIUS_M=200
DUPLICATE_WINDOW_MIN=120
# An officer's shared location older than this many minutes is flagged as old and the
# officer is not suggested as the nearest (default shown).
OFFICER_LOCATION_STALE_MIN=120
# An officer shows as live (blinking) on the admin map while their position is newer than this many minutes.
OFFICER_LIVE_WINDOW_MIN=5
