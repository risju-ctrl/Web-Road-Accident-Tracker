diff --git a/Web Road Accident Reporting System/config/db.js b/Web Road Accident Reporting System/config/db.js
index e5447ef..579ce7c 100644
--- a/Web Road Accident Reporting System/config/db.js	
+++ b/Web Road Accident Reporting System/config/db.js	
@@ -16,6 +16,16 @@ const pool = new pg.Pool({
   // The connection is still encrypted.
   ssl: { rejectUnauthorized: false },
   max: 10,
+  // Opening a connection to a remote database costs several round trips (TCP, TLS,
+  // login), seconds on a long-distance link. node-postgres closes idle connections
+  // after 10 s by default, which made the first request after a short pause as slow
+  // as a cold start. Keep them for 5 min; the heartbeat below keeps a couple warm.
+  idleTimeoutMillis: 5 * 60 * 1000,
+  // Do not hang forever when the database is unreachable.
+  connectionTimeoutMillis: 15000,
+  // TCP keep-alive stops routers and the pooler from silently dropping a quiet socket.
+  keepAlive: true,
+  keepAliveInitialDelayMillis: 10000,
   // No session time zone is set here on purpose. MySQL ran with timezone=SYSTEM
   // (Asia/Manila) and the summaries group reports by day and month in SQL, so the
   // database's default time zone for this role is set to Asia/Manila instead: the
@@ -59,14 +69,47 @@ async function query(sql, params = []) {
   try {
     const result = await pool.query(text, params);
     if (result.command === 'SELECT') return [result.rows, result.fields];
-    return [{ insertId: result.rows[0] ? result.rows[0].id : null, affectedRows: result.rowCount }, result.fields];
+    // `rows` holds whatever a RETURNING clause produced, so a write can hand back the
+    // row it touched without a second SELECT (one fewer round trip).
+    return [{ insertId: result.rows[0] ? result.rows[0].id : null, affectedRows: result.rowCount, rows: result.rows }, result.fields];
   } catch (err) {
     if (SQLSTATE_TO_MYSQL[err.code]) err.code = SQLSTATE_TO_MYSQL[err.code];
     throw err;
   }
 }
 
+// Opens a few connections up front and keeps them used, so a request never has to wait
+// for a new connection. Call once when the server starts. The timer is unref'd so it
+// never keeps a script or test process alive.
+const HOT_CONNECTIONS = Math.max(1, Number(process.env.DB_WARM_CONNECTIONS) || 4);
+const HEARTBEAT_MS = 30 * 1000;
+let heartbeat = null;
+
+async function ping() {
+  // Concurrent queries need separate clients, so this touches HOT_CONNECTIONS of them.
+  // 4 covers the widest fan-out in the app (3 parallel queries on the report page).
+  await Promise.all(Array.from({ length: HOT_CONNECTIONS }, () => pool.query('select 1')));
+}
+
+async function warm() {
+  const started = Date.now();
+  try {
+    await ping();
+    console.log(`database warm: ${HOT_CONNECTIONS} connection(s) ready in ${Date.now() - started} ms`);
+  } catch (err) {
+    console.error('database warm-up failed:', err.message);
+  }
+  if (!heartbeat) {
+    heartbeat = setInterval(() => ping().catch((err) => console.error('database heartbeat failed:', err.message)), HEARTBEAT_MS);
+    heartbeat.unref();
+  }
+}
+
 export default {
   query,
-  end: () => pool.end()
+  warm,
+  end: () => {
+    if (heartbeat) clearInterval(heartbeat);
+    return pool.end();
+  }
 };
diff --git a/Web Road Accident Reporting System/database/migrations/005_postgres_indexes.sql b/Web Road Accident Reporting System/database/migrations/005_postgres_indexes.sql
new file mode 100644
index 0000000..4226ec6
--- /dev/null
+++ b/Web Road Accident Reporting System/database/migrations/005_postgres_indexes.sql	
@@ -0,0 +1,34 @@
+-- Postgres (Supabase). Run once in the Supabase SQL editor. Safe to re-run.
+--
+-- migrations/003_report_indexes.sql was written for MySQL; Postgres does NOT create
+-- indexes for foreign keys by itself, so unless these were added by hand every filter,
+-- join and "my reports / my notifications" lookup below is a full table scan.
+-- Check what already exists with:
+--   select tablename, indexname from pg_indexes where schemaname = 'public' order by 1, 2;
+
+-- reports: the list/filter/dashboard/map queries
+CREATE INDEX IF NOT EXISTS idx_reports_created        ON reports (created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_reports_status_created ON reports (status, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_reports_reporter       ON reports (reporter_id, created_at DESC);   -- reporter's own list
+CREATE INDEX IF NOT EXISTS idx_reports_assigned       ON reports (assigned_to, created_at DESC);   -- officer's list, open_cases
+CREATE INDEX IF NOT EXISTS idx_reports_category       ON reports (accident_category_id);
+CREATE INDEX IF NOT EXISTS idx_reports_accident_date  ON reports (accident_date);                  -- duplicate check
+CREATE INDEX IF NOT EXISTS idx_reports_duplicate_of   ON reports (duplicate_of);
+CREATE INDEX IF NOT EXISTS idx_reports_verified_by    ON reports (verified_by);
+
+-- report detail page: one lookup per table
+CREATE INDEX IF NOT EXISTS idx_evidence_report        ON report_evidence (report_id);
+CREATE INDEX IF NOT EXISTS idx_evidence_uploader      ON report_evidence (uploader_id);
+CREATE INDEX IF NOT EXISTS idx_history_report         ON report_status_history (report_id, changed_at DESC);
+CREATE INDEX IF NOT EXISTS idx_history_changed_by     ON report_status_history (changed_by);
+
+-- notifications: polled every 30 s by every signed-in browser
+CREATE INDEX IF NOT EXISTS idx_notif_user_created     ON notifications (user_id, created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_notif_user_unread      ON notifications (user_id) WHERE is_read = false;
+CREATE INDEX IF NOT EXISTS idx_notif_report           ON notifications (report_id);
+
+-- audit log page
+CREATE INDEX IF NOT EXISTS idx_audit_created          ON audit_logs (created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_audit_user             ON audit_logs (user_id);
+
+ANALYZE;
