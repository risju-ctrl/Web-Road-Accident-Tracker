 // shortcut: move to a DB table if the API ever runs more than one process
 const blockedTokenIds = new Set();
 
+// Every API call used to run `SELECT ... FROM users` before doing its real work. With the
+// database in Supabase that is one extra network round trip per request, so the result is
+// kept for a few seconds. User.update/remove clear it, so deactivating or changing the role
+// of an account still takes effect immediately.
+const USER_CACHE_MS = 15000;
+const userCache = new Map();
+
+export function clearUserCache(id) {
+  if (id === undefined) userCache.clear();
+  else userCache.delete(Number(id));
+}
+
+async function loadUser(id) {
+  const hit = userCache.get(id);
+  if (hit && hit.expires > Date.now()) return hit.user;
+  const [rows] = await pool.query('SELECT id, name, email, role, phone, is_active FROM users WHERE id = ?', [id]);
+  const user = rows[0] || null;
+  if (user) userCache.set(id, { user, expires: Date.now() + USER_CACHE_MS });
+  return user;
+}
+
